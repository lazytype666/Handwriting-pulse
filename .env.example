# 开发时复制为 .env.local。保留空值即可演示纯离线能力。
# 1) （推荐）商用大模型 API 统一配置：VLM 识题与解题图谱预解/实时提示可共用同一 OpenAI 兼容网关与 Key
#    - 方案 A（同平台专职双模型）：VLM 用 qwen-vl-max / gemini-2.5-flash，解题用 deepseek-v3 / qwen-max / gemini-2.5-pro
#    - 方案 B（单多模态模型共用）：只填 EXPO_PUBLIC_LLM_BASE_URL / KEY / MODEL（如 gemini-2.5-flash 或 qwen-vl-max），VLM 自动共用
EXPO_PUBLIC_LLM_BASE_URL=
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=
# 如识题模型与解题模型不同，仅需额外指定 EXPO_PUBLIC_VLM_MODEL（自动沿用上方 BASE_URL 与 KEY；也可独立覆盖 VLM 地址）
# EXPO_PUBLIC_VLM_MODEL=qwen-vl-max
# EXPO_PUBLIC_VLM_BASE_URL=
# EXPO_PUBLIC_VLM_API_KEY=

# 2) （可选）本地或局域网模型覆盖（例如电脑 Ollama：http://auto:11434 自动跟随 Metro 局域网 IP）
# EXPO_PUBLIC_EDGE_LLM_URL=
# EXPO_PUBLIC_EDGE_LLM_MODEL=inkpulse-math
# EXPO_PUBLIC_EDGE_LLM_TIMEOUT_MS=45000

# 3) （可选）个性化学习智能体轻量后端地址（不填时自动由前端直连商用 LLM API 或本地离线画像兜底）
# EXPO_PUBLIC_AGENT_BACKEND_URL=
